{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "owenvoke/cachent",
    "type": "project",
    "description": "A secure, open source torrent cache.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "arokettu/torrent-file": "^5.3.4",
        "laravel/framework": "^13.30",
        "laravel/jetstream": "^5.5.3",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "livewire/livewire": "^3.8.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.11",
        "laravel/pint": "^1.30.5",
        "laravel/sail": "^1.67",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.1.3",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "spatie/laravel-ignition": "^2.12",
        "thecodingmachine/phpstan-safe-rule": "^1.4.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test:lint": "pint --test --ansi",
        "test:types": "phpstan analyse --memory-limit=-1 --ansi",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
